# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# DISCORD_TOKEN: Bot token from https://discord.com/developers/applications
#   -> your app -> Bot -> Reset Token. Regenerate if it ever leaks.
# IDs: enable Developer Mode in Discord (Settings -> Advanced),
#   then right-click the user / server / channel -> Copy ID.

DISCORD_TOKEN=paste-token-here
OWNER_UID=your-discord-user-id
GUILD_ID=your-server-id
DEFAULT_CHANNEL_ID=your-channel-id

# Optional overrides:
# SESSION_ID: audit/heartbeat label only on the neutral gateway path
#   (the MCP lifespan starts no worker loops). [DEPRECATED] as a Thyca
#   session concept — session memory belongs to the dedicated bot.
# SESSION_ID=discord-main
# INTENT_MESSAGE_CONTENT=true
# INTENT_MEMBERS=true

# WATCH_CHANNEL_IDS: JSON list of channel IDs captured into the outbox (v4).
# Unset or "[]" means [DEFAULT_CHANNEL_ID]. IDs are not secrets.
# WATCH_CHANNEL_IDS="[123, 456]"

# V5 auto-reply [DEPRECATED worker path] — legacy settings outside the neutral
# MCP path. The lifespan no longer starts the worker loops and never POSTs
# /api/sessions; these only matter for the retained correlated tools when a
# session mapping file exists. Optional; non-secret operational tuning:
# THYCA_BASE_URL: Thyca agent HTTP base URL. Loopback only; validated by the
#   native client before any request. Default: http://127.0.0.1:8765
# THYCA_BASE_URL=http://127.0.0.1:8765
# THYCA_SESSION_MAPPING_PATH: Existing discord-main native SID mapping;
#   read/validated by responder, Settings stores path only. When this file is
#   absent the server runs as a pure Discord gateway (no Responder at all).
#   Default: ~/.thyca/discord_session.json
# THYCA_SESSION_MAPPING_PATH=/home/user/.thyca/discord_session.json
# DELIVERY_STATE_PATH: responder delivery cursors (private, gitignored).
#   Default: ./delivery_state.json
# DELIVERY_STATE_PATH=./delivery_state.json
# RESPONDER_CHECK_SECONDS: responder poll tick. Finite, > 0. Default: 1.0
# RESPONDER_CHECK_SECONDS=1.0
# THYCA_REQUEST_TIMEOUT_SECONDS: per-request technical bound. Finite, > 0.
#   Default: 900.0
# THYCA_REQUEST_TIMEOUT_SECONDS=900.0
# RECOVERY_POLL_SECONDS: recovery poll interval. Finite, >= 30. Default: 30.0
# RECOVERY_POLL_SECONDS=30.0

# Modum Jev integration [DEPRECATED worker path] (source complete; NOT deployed
# or authorized to start):
# SDK is pinned code constants (not env): typesafe-sdk==0.7.2, model jev-1.13.0,
# one call per source, retry 0, timeout 10.0 s. No new manual-enable/owner-only/
# mention threshold mode.
# TYPESAFE_API_KEY: TypeSafe Jev API key for paid classification. Required for
#   the real responder (lazy SecretStr, read only when the responder builds its
#   real Jev adapter; never log/echo/repr). Default None (tests inject fakes).
# TYPESAFE_API_KEY=paste-typesafe-key-here
# JEV_STATE_PATH: Jev participation ledger state (private, gitignored, 0600).
#   Optional; when unset, derived BESIDE the configured DELIVERY_STATE_PATH
#   (same parent, jev_state.json) so tmp delivery paths never leak ledger
#   writes to the repo root. Must not lexically collide with delivery/outbox/
#   outbox-state/audit/mapping paths (../ and abs-vs-relative aliases rejected
#   before any I/O). The ledger refuses symlink paths; hardlink aliases are
#   not detected. No all-physical-alias safety is claimed. New parent dirs
#   0700; existing parents never chmodded.
# JEV_STATE_PATH=./jev_state.json
# Per-call Jev spend has NO daily stop: unknown or started billing still halts
# NEW attempts across restart/day rollover; exact decided cache returns with
# no rebill.
# CONVERSATION_MAX_MESSAGES: Canonical context window: whole recent messages,
#   strict 1..20, default 20. Env strings with clean ints coerce; bools/floats
#   rejected.
# CONVERSATION_MAX_MESSAGES=20

# Daily native-session rotation [DEPRECATED worker path] — one session per
# logical day; old sessions are never deleted. Rotation is automatic,
# drain-gated (every delivery job must
# be safe-terminal first), transient-deferring (a native blip retries next
# tick instead of halting), and lazy (a quiet day creates no empty session).
# The legacy dateless mapping is sealed to the current day on first tick.
# DAILY_SESSION_ROTATION: set false to pin the single mapped session forever.
#   Default: true
# DAILY_SESSION_ROTATION=true
# SESSION_DAY_TIMEZONE: IANA timezone of the rotation logical day. Must parse
#   via zoneinfo; validated eagerly (bad zones fail at startup, never mid-tick).
#   Default: Asia/Ho_Chi_Minh
# SESSION_DAY_TIMEZONE=Asia/Ho_Chi_Minh
# SESSION_DAY_ROLLOVER_HOUR: wall hour (0..23) the logical day flips. 04:00
#   keeps a late-night conversation in one session. Env strings with clean
#   ints coerce; bools/floats rejected.
#   Default: 4
# SESSION_DAY_ROLLOVER_HOUR=4
