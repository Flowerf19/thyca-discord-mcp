# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# DISCORD_TOKEN: Bot token from https://discord.com/developers/applications
#   -> your app -> Bot -> Reset Token. Regenerate if it ever leaks.
# IDs: enable Developer Mode in Discord (Settings -> Advanced),
#   then right-click the user / server / channel -> Copy ID.

DISCORD_TOKEN=paste-token-here
OWNER_UID=your-discord-user-id
GUILD_ID=your-server-id
DEFAULT_CHANNEL_ID=your-channel-id

# Optional overrides:
# INTENT_MESSAGE_CONTENT=true
# INTENT_MEMBERS=true
#
# NOTE: INTENT_MEMBERS=false fails loudly at startup when chunking is on
# (discord.py raises ValueError for intent_members=False + chunking, because
# the member cache would be empty). Either keep the members intent enabled
# or also set CHUNK_GUILDS_AT_STARTUP=false.

# CHUNK_GUILDS_AT_STARTUP: fill the member cache before ready so
# guild.members reads are complete. Default: true.
# CHUNK_GUILDS_AT_STARTUP=true

# TARGET_BOT_ID: the bot whose fixed DM session receives auto-reply turns.
# Required-effective (empty/invalid values fail startup): the worker resolves
# GET /api/bots/<bot_id>/dm every tick and posts turns into that DM session,
# so the user reads auto-replies in the bot's DM chat with no manual step.
# Default: march7th
# TARGET_BOT_ID=march7th

# WATCH_CHANNEL_IDS: JSON list of channel IDs captured into the outbox.
# Unset or "[]" means [DEFAULT_CHANNEL_ID]. IDs are not secrets.
# WATCH_CHANNEL_IDS="[123, 456]"

# DB_PATH: the only state store (SQLite: outbox, jobs, sends, Jev decisions,
# session provenance, poll cursors). Real default: <project-root>/state.db
# (plus -wal/-shm sidecars, 0600 best-effort) — set DB_PATH to override.
# Must differ from the audit log path (startup rejects a collision).
# DB_PATH=./state.db

# Responder tuning (optional; non-secret operational tuning):
# THYCA_BASE_URL: Thyca agent HTTP base URL. Loopback only; validated by the
#   native client before any request. Default: http://127.0.0.1:8765
# THYCA_BASE_URL=http://127.0.0.1:8765
# RESPONDER_CHECK_SECONDS: responder poll tick. Finite, > 0. Default: 1.0
# RESPONDER_CHECK_SECONDS=1.0
# THYCA_REQUEST_TIMEOUT_SECONDS: per-request technical bound. Finite, > 0.
#   Default: 900.0
# THYCA_REQUEST_TIMEOUT_SECONDS=900.0
# RECOVERY_POLL_SECONDS: recovery poll interval. Finite, >= 30. Default: 30.0
# RECOVERY_POLL_SECONDS=30.0

# Jev integration (source-complete tuning):
# SDK is pinned code constants (not env): typesafe-sdk==0.7.2,
# model jev-1.13.0, one call per source, retry 0, timeout 10.0 s.
# A crashed pending row gets exactly one retry; a still-unknown outcome at
# attempts == 2 resolves terminally as observe (synthetic owner-ordered
# observe, stored as decided with the retry's usage/cost).
# TYPESAFE_API_KEY: TypeSafe Jev API key for paid classification. Required for
#   the real responder (lazy SecretStr, read only when the responder builds its
#   real Jev adapter; never log/echo/repr). Default None (tests inject fakes).
# TYPESAFE_API_KEY=paste-typesafe-key-here
# Per-call Jev spend has NO daily stop: unknown billing on a first attempt
# still halts NEW attempts for that source; exact decided cache returns with
# no rebill.
# CONVERSATION_MAX_MESSAGES: Canonical context window: whole recent messages,
#   strict 1..20, default 20. Env strings with clean ints coerce; bools/floats
#   rejected.
# CONVERSATION_MAX_MESSAGES=20
